{
  "manifest_version": 3,
  "name": "Trivial",
  "version": "0.2.2",
  "description": "A new tab page you lay out yourself: links, groups, clock, weather, notes, web pages and images.",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "chrome_url_overrides": { "newtab": "index.html" },
  "chrome_settings_overrides": { "homepage": "index.html" },
  "background": { "scripts": ["background.js"] },
  "commands": {
    "replace-tab": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Turn the current tab into a new tab"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "search", "webNavigation"],
  "host_permissions": ["https://www.google.com/s2/favicons*", "https://*.gstatic.com/faviconV2*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "foyer@theohallgren",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
